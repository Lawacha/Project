<% layout('layouts/boilerplate') %>
    <div class="row mt-2 mb-5 offset-3">
        <h2>Login</h2>
        <div class="col-8  mt-4">
            <form action="http://localhost:8080/login" method="post" class="needs-validation" novalidate>

                <div class="mb-3">
                    <label for="username" class="form-label">Username:</label>
                    <input type="text" placeholder="Enter usernmae" name="username" id="username" class="form-control"
                        required>
                       </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password:</label>
                    <input type="password" name="password" id="password" class="form-control" required>
                </div>
                <button class="btn btn-success">Submit</button>
            </form>

        </div>
    </div>