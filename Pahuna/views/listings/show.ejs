<% layout('../layouts/boilerplate') %>

   <div class="row mt-4 mb-5 ">
    <div class="col-lg-5 col-sm-6 offset-4 ">
         <h1 class="mb-3"><%= showList.title %></h1>
        </div>
    <div class="card col-lg-4 col-sm-7 offset-4">
        <img src="<%= showList.image.url %>" class="card-img-top show-img " alt="listing image">
        <div class="card-body p-3">
            <p class="card-text">
                <%= showList.description %> <br>
                Rs.<%= showList.price.toLocaleString('en-In') %> <br>
                <%= showList.location %> <br>
                <%= showList.country %>
            </p>
        </div>
    </div>

    <div class="btns col-6 offset-4">
        <a  class="btn  btn-primary alert" href="/listings/<%= showList._id %>/edit">Edit</a>&nbsp;&nbsp;&nbsp;&nbsp;
    <form action="/listings/<%= showList._id %>?_method=DELETE" method="post">
        <button onclick="alert('Deleted listing <%=showList.title%>')"  class="btn btn-danger alert ">Delete</button>
    </form>
    </div>

    </div>

    <hr>

    <div class="col-lg-5 col-sm-6 offset-4 ">
        <form action="">
            <h2>Leava a review</h2>
            <input type="range"> <br>
            <textarea name="" id=""></textarea>
        </form>
    </div>

