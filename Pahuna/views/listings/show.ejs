<% layout('../layouts/boilerplate') %>
   <div class="row mt-4 mb-5">
    <div class="col-6 offset-4">
         <h1>Show Route</h1>
        </div>
    <div class="card col-4 offset-4">
        <img src="<%= showList.image.url %>" class="card-img-top show-img " alt="listing image">
        <div class="card-body p-3">
            <p class="card-text"><b><%= showList.title %></b><br>
                <%= showList.description %> <br>
                Rs.<%= showList.price.toLocaleString('en-In') %> <br>
                <%= showList.location %> <br>
                <%= showList.country %>
            </p>
        </div>
    </div>

    <div class="btns col-6 offset-4">
        <a class="btn  btn-primary" href="/listings/<%= showList._id %>/edit">Edit</a>&nbsp;&nbsp;&nbsp;&nbsp;
    <form action="/listings/<%= showList._id %>?_method=DELETE" method="post">
        <button  class="btn btn-danger ">Delete</button>
    </form>
    </div>

    </div>

