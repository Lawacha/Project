<% layout('layouts/boilerplate') %>
    <div class="row mt-4 mb-5 ">
        <div class="col-8 col-sm-6 offset-3 ">
            <h1 class="mb-3">
                <%= showList.title %>
            </h1>
        </div>
        <div class="card listing-card col-lg-5 col-sm-7 offset-3">
            <img src="<%= showList.image.url %>" class="card-img-top show-img " alt="listing image">
            <div class="card-body p-3">
                <i>
                    <p>Owned by <%=showList.owner.username%>
                    </p>
                </i>
                <p class="card-text">
                    <%= showList.description %> <br>
                        Rs. <%= showList.price.toLocaleString('en-In') %> <br>
                            <%= showList.location %> <br>
                                <%= showList.country %>
                </p>
            </div>
        </div>

        <% if(currentUser && currentUser._id.equals(showList.owner._id)) {%>
            <div class="btns col-6 offset-3">
                <a class="btn  btn-outline-primary alert"
                    href="/listings/<%= showList._id %>/edit">Edit</a>&nbsp;&nbsp;&nbsp;&nbsp;
                <form action="/listings/<%= showList._id %>?_method=DELETE" method="post">
                    <button onclick="alert('Deleted listing <%=showList.title%>')"
                        class="btn btn-outline-danger alert ">Delete</button>
                </form>
            </div>
            <% }%>

    </div>

    <hr>


    <!-- Reviews form -->
    <%if(currentUser){ %>
        <div class="col-8 col-sm-6 offset-3 mb-3">
            <form action="/listings/<%= showList.id %>/reviews" method="post" novalidate class="needs-validation">

                <h3>Leave a review</h3>
                <!-- <div class="mb-3 mt-3">
                    <label class="form-label" for="rating">Rating</label><br>
                    <input type="range" class="form-range" id="rating" min="1" max="5" name="review[rating]"> <br>
                </div> -->
                <fieldset class="starability-checkmark">
                    <legend>
                        <h5>Rating :</h5>
                    </legend>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                        aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>



                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">
                        <h5>Comment :</h5>
                    </label> <br>
                    <textarea name="review[comment]" id="comment" class="form-control" rows="5" cols="4"
                        required></textarea>
                    <div class="invalid-feedback">Please enter comment for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        </div>
        <hr>
        <% }%>

            <!-- Reviews -->
            <div class="col-8 offset-3 mb-3">
                <h4>Reviews</h4>
                <div class="row">
                    <%for(review of showList.review){%>
                        <div class="card col-5 mb-2 ms-2 pb-2">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%=review.author.username %>
                                </h5>

                                <p class="starability-result" data-rating="<%= review.rating %>"> </p>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>
                                <%if(currentUser){%>
                                    <form
                                        action="/listings/<%= showList._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="post">
                                        <button class="btn btn-outline-danger">Delete</button>
                                    </form>
                                    <%}%>
                            </div>
                        </div>
                        <% } %>
                </div>


            </div>