<% layout('../layouts/boilerplate') %>

    <div class="row mt-4 mb-5 ">
        <div class="col-lg-5 col-sm-6 offset-4 ">
            <h1 class="mb-3">
                <%= showList.title %>
            </h1>
        </div>
        <div class="card col-lg-4 col-sm-7 offset-4">
            <img src="<%= showList.image.url %>" class="card-img-top show-img " alt="listing image">
            <div class="card-body p-3">
                <p class="card-text">
                    <%= showList.description %> <br>
                        Rs.<%= showList.price.toLocaleString('en-In') %> <br>
                            <%= showList.location %> <br>
                                <%= showList.country %>
                </p>
            </div>
        </div>

        <div class="btns col-6 offset-4">
            <a class="btn  btn-primary alert" href="/listings/<%= showList._id %>/edit">Edit</a>&nbsp;&nbsp;&nbsp;&nbsp;
            <form action="/listings/<%= showList._id %>?_method=DELETE" method="post">
                <button onclick="alert('Deleted listing <%=showList.title%>')"
                    class="btn btn-danger alert ">Delete</button>
            </form>
        </div>

    </div>

    <hr>

    <div class="col-lg-4 col-sm-6 offset-4 mb-3">
        <form action="/listings/<%= showList.id %>/reviews" method="post" novalidate class="needs-validation">
            <h4>Leave a review</h4>
            <div class="mb-2">
                <label class="form-label" for="rating">Rating</label><br>
                <input type="range"  class="form-range" id="rating" min="1" max="5"  name="reviews[ratings]"> <br>
            </div>
            <div class="mb-2">
                <label for="comment" class="form-label">Comment</label> <br>
                <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                <div class="invalid-feedback">Please enter comment for review</div>
            </div>

            <div class="mt-3">
            <button class="btn btn-outline-dark">Submit</button>

            </div>
        </form>
    </div>